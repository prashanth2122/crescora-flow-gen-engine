{
  "name": "@zero-code/flow-generator",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "npm run contract:generate && npm run domains:build",
    "contract:generate": "node scripts/sync-contract-from-app.mjs",
    "contract:check": "node scripts/sync-contract-from-app.mjs --check",
    "test:notifications": "node --test scripts/notification-data.test.mjs",
    "test:flow-return": "node --test scripts/validate-flow-return.test.mjs",
    "test:localized-content": "node --test scripts/validate-localized-content.test.mjs",
    "domains:build": "node scripts/run-domain-workflows.mjs build",
    "domains:validate": "node scripts/run-domain-workflows.mjs validate",
    "domains:check": "node scripts/run-domain-workflows.mjs check",
    "domains:check:strict": "node scripts/run-domain-workflows.mjs check:strict",
    "domain:hospital:build": "node scripts/build-hospital-full-automation.mjs",
    "domain:hospital:validate": "node scripts/validate-flow-export.mjs domains/hospital/templates/hospital-full-automation.flow.json",
    "domain:hospital:appointment-single-branch:build": "node scripts/build-hospital-appointment-single-branch.mjs",
    "domain:hospital:appointment-single-branch:validate": "node scripts/validate-flow-export.mjs domains/hospital/templates/assai-deepa-hospital-appointment-single-branch.flow.json",
    "domain:real-estate:build": "node scripts/build-real-estate-lead-to-site-visit.mjs",
    "domain:real-estate:validate": "node scripts/validate-flow-export.mjs domains/real-estate/templates/real-estate-lead-to-site-visit.flow.json",
    "domain:financial-services:build": "node scripts/build-financial-services-loan-advisor-automation.mjs",
    "domain:financial-services:validate": "node scripts/validate-flow-export.mjs domains/financial-services/templates/financial-services-loan-advisor-automation.flow.json",
    "domain:education:build": "node scripts/build-education-admission-operating-system.mjs",
    "domain:education:validate": "node scripts/validate-flow-export.mjs domains/education/templates/education-admission-operating-system.flow.json",
    "domain:hotels-travel:build": "node scripts/build-hotels-travel-digital-front-desk.mjs",
    "domain:hotels-travel:validate": "node scripts/validate-flow-export.mjs domains/hotels-travel/templates/hotel-digital-front-desk.flow.json",
    "domain:retail-ecommerce:build": "node scripts/build-retail-ecommerce-killer-automation.mjs",
    "domain:retail-ecommerce:validate": "node scripts/validate-flow-export.mjs domains/retail-ecommerce/templates/retail-ecommerce-killer-automation.flow.json",
    "domain:insurance:build": "node scripts/build-insurance-claim-policy-service.mjs",
    "domain:insurance:validate": "node scripts/validate-flow-export.mjs domains/insurance/templates/insurance-claim-policy-service.flow.json",
    "domain:automobile:build": "node scripts/build-automobile-customer-lifecycle-assistant.mjs",
    "domain:automobile:validate": "node scripts/validate-flow-export.mjs domains/automobile/templates/automobile-customer-lifecycle-assistant.flow.json",
    "domain:local-professional-services:build": "node scripts/build-local-professional-services-automation.mjs",
    "domain:local-professional-services:validate": "node scripts/validate-flow-export.mjs domains/local-professional-services/templates/local-professional-services-killer-automation.flow.json",
    "domain:interior-design:build": "node scripts/build-interior-design-sales-consultant.mjs",
    "domain:interior-design:validate": "node scripts/validate-flow-export.mjs domains/interior-design/templates/interior-design-sales-consultant.flow.json",
    "domain:hospital:audit:journeys": "node scripts/audit-hospital-journeys.mjs",
    "domain:hospital:audit:content": "node scripts/audit-hospital-content.mjs",
    "test:hospital:appointment-single-branch": "node --test scripts/hospital-appointment-single-branch.test.mjs",
    "template:build": "npm run domain:hospital:build",
    "template:validate": "npm run domain:hospital:validate",
    "template:audit:journeys": "npm run domain:hospital:audit:journeys",
    "template:audit:content": "npm run domain:hospital:audit:content",
    "check": "npm run contract:check && npm run test:localized-content && npm run domains:check",
    "check:strict": "npm run contract:check && npm run test:localized-content && npm run domains:check:strict"
  }
}
